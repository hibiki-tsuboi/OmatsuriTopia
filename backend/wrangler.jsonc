{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omatsuritopia-ranking",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "omatsuritopia-ranking",
    "database_id": "50980f61-3a15-4c0a-be4c-7dd992521b87",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    { "name": "REQUEST_LIMIT", "namespace_id": "7261001", "simple": { "limit": 120, "period": 60 } },
    { "name": "REGISTER_LIMIT", "namespace_id": "7261002", "simple": { "limit": 10, "period": 60 } }
  ],
  "triggers": { "crons": ["15 19 * * *"] }
}
